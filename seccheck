  exit_noresp  "не вдалось визначити (нема відповіді)"
  exit_ok      "%s, %s — %s"
  exit_owner   "%s, %s — %s · блок %s"
  exit_unset   "%s, %s — %s · провайдера не задано (VPN_ORG_MATCH)"
  exit_bad     "%s · %s, %s — %s (не VPN!)"
