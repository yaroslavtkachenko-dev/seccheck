#!/bin/zsh
# seccheck — macOS security posture in one command: VPN tunnel, leaks, open
# ports, device settings, backups. No sudo, no dependencies.
# Exit code: 0 clean · 1 warnings · 2 problems.
# https://github.com/yaroslavtkachenko-dev/seccheck

emulate -L zsh
setopt pipefail

VERSION=1.0.0

# In a non-interactive shell (launchd, cron) the locale is empty, and then
# ${#str} counts bytes instead of characters, so non-ASCII labels break the
# column alignment.
if [[ $LC_ALL != *UTF-8* && $LANG != *UTF-8* && $LC_CTYPE != *UTF-8* ]]; then
  if locale -a 2>/dev/null | grep -qx en_US.UTF-8; then export LC_ALL=en_US.UTF-8
  else export LC_ALL=C.UTF-8; fi
fi
setopt multibyte

# $0 inside a zsh function is the function name, not the script path, so the
# path is captured here at the top level. :a leaves symlinks unresolved on
# purpose: a Homebrew bin path survives upgrades, the Cellar path behind it
# does not, and this path ends up in the launchd plist.
SELF=${0:a}

# Nothing is stored next to the script: it may live in a read-only or
# versioned directory.
CONF=${SECCHECK_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/seccheck/seccheck.conf}
STATE_FILE=${SECCHECK_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/seccheck/state}
LOG=${SECCHECK_LOG:-$HOME/Library/Logs/seccheck.log}

# The agent appends to the log on every run. Truncate in place (same inode)
# rather than via mv: launchd keeps its descriptor open and would go on
# writing into a detached file, and the log would silently stop growing.
if [[ -f $LOG ]] && (( $(stat -f %z $LOG 2>/dev/null || print 0) > 524288 )); then
  KEEP=$(tail -n 200 $LOG 2>/dev/null); print -r -- $KEEP > $LOG
fi

# --- defaults (override in the config file, see --init-config) ---
VPN_EXPECTED=1                 # 0 = no VPN in use: tunnel checks become informational
VPN_ORG_MATCH=""               # regex: who should own the exit IP
TUNNEL_PREFIX="utun"           # tunnel interface prefix
ALLOWED_LISTENERS=(ControlCenter rapportd sharingd remoted AirPlayXPCHelper)
IP_ENDPOINTS=(https://ipinfo.io/json https://ifconfig.co/json)
RDAP_ENDPOINT=https://rdap.org/ip   # registry: who owns an address block
NET_TIMEOUT=8
UI_LANG=""                     # "en" or "uk"; empty = follow the macOS language

[[ -r $CONF ]] && source $CONF

# --- language ---
UI=${SECCHECK_LANG:-$UI_LANG}
if [[ -z $UI ]]; then
  UI=$(defaults read -g AppleLanguages 2>/dev/null | sed -n '2{s/[" ,]//g;p;}')
fi
[[ $UI == uk* ]] && UI=uk || UI=en

typeset -A T
if [[ $UI == uk ]]; then T=(
  h_net        "МЕРЕЖА"
  h_ports      "ВІДКРИТІ ПОРТИ"
  h_dev        "ПРИСТРІЙ"
  h_bak        "БЕКАПИ"
  l_route      "Маршрут"
  l_uplink     "Канал"
  l_dns        "DNS"
  l_ipv6       "IPv6"
  l_exit       "Точка виходу"
  l_gw         "Локальний шлюз"
  l_listen     "Слухачі"
  l_fv         "FileVault"
  l_sip        "SIP"
  l_gk         "Gatekeeper"
  l_fw         "Фаєрвол"
  l_stealth    "Stealth mode"
  l_disk       "Місце на диску"
  l_tm         "Time Machine"
  unknown      "невідомо"
  route_none   "маршруту за замовчуванням нема — мережі немає"
  route_tun    "%s — весь трафік у тунелі"
  route_out    "%s — трафік ПОЗА тунелем"
  route_plain  "%s — без VPN, як і налаштовано"
  uplink_ok    "%s — %s"
  uplink_none  "фізичний інтерфейс з адресою не знайдено"
  dns_none     "резолвер не визначено"
  dns_via      "%s через %s"
  dns_out      "%s через %s — запити ПОЗА тунелем"
  v6_none      "маршруту нема — витекти нічим"
  v6_tun       "%s — у тунелі"
