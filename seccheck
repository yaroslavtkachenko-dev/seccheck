  l_fv         "FileVault"
  l_sip        "SIP"
  l_gk         "Gatekeeper"
  l_fw         "Firewall"
  l_stealth    "Stealth mode"
  l_disk       "Disk space"
  l_tm         "Time Machine"
  unknown      "unknown"
  route_none   "no default route — offline"
  route_tun    "%s — all traffic goes through the tunnel"
  route_out    "%s — traffic BYPASSES the tunnel"
  route_plain  "%s — no VPN, as configured"
  uplink_ok    "%s — %s"
  uplink_none  "no physical interface with an address"
  dns_none     "resolver not found"
  dns_via      "%s via %s"
  dns_out      "%s via %s — queries BYPASS the tunnel"
  v6_none      "no route — nothing to leak"
  v6_tun       "%s — inside the tunnel"
  v6_out       "%s — bypasses the tunnel"
  v6_plain     "%s — no VPN, as configured"
  exit_skip    "skipped (--no-net)"
  exit_noresp  "could not determine (no response)"
  exit_ok      "%s, %s — %s"
  exit_owner   "%s, %s — %s · block owner %s"
  exit_unset   "%s, %s — %s · provider not set (VPN_ORG_MATCH)"
  exit_bad     "%s · %s, %s — %s (not your VPN!)"
  gw_none      "not advertised"
  gw_up        "%s responds — you are visible on the LAN"
  gw_up_plain  "%s responds"
  gw_down      "%s unreachable — LAN is cut off"
  gw_blocked   "%s blocked for this process — kill switch or Local Network permission"
  listen_none  "nothing listens on external addresses"
  listen_ok    "%s — allowlisted"
  listen_unk   "process unknown (run with sudo to see it)"
  listen_bad   "%s — NOT ALLOWLISTED, reachable from the network"
  on           "on"
  off          "off"
  off_loud     "OFF"
  sip_custom   "custom configuration — partly disabled"
  disk         "%s%% used, %s GB free"
  disk_bad     "%s%% used, %s GB free — local snapshots will not survive"
  tm_none      "no destinations configured"
  tm_unavail   "config unreadable"
  enc          "encrypted"
  notenc       "NOT encrypted"
  sum_bad      "Problems: %s"
  sum_bad_w    ", warnings: %s"
  sum_warn     "Warnings: %s"
  sum_warn_b   ", no problems"
